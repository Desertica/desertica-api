# Copia este archivo a `.env` y ajusta los valores. Las variables se validan al
# arrancar (src/config/env.validation.ts): si falta una obligatoria, la API no inicia.

NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Credenciales locales de desarrollo (docker compose / Postgres nativo).
# No uses estos valores en producción.
DATABASE_URL="postgresql://desertica:desertica@localhost:5432/desertica?schema=public"

# Opcional. Sin Redis el rate limit y la caché viven en memoria (una sola instancia).
# REDIS_URL="redis://localhost:6379"

# Orígenes CORS permitidos, separados por coma (obligatorio en producción).
CORS_ORIGINS="http://localhost:4200,http://localhost:4300"
# Saltos de proxy confiables para leer la IP real (Cloudflare + Coolify: 2). Obligatorio en producción:
# sin él todos los clientes compartirían la IP del proxy y el rate limit.
TRUST_PROXY=0
# Rate limit global por IP.
THROTTLE_LIMIT=120
THROTTLE_TTL_MS=60000

# Pool de conexiones a Postgres (por instancia). Sin conexión libre tras el tiempo de espera, la API responde 503.
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TX_TIMEOUT_MS=30000

# Base de los enlaces que se mandan por correo (sitio público).
PUBLIC_WEB_URL="http://localhost:4200"

# Auth del staff (login con Google).
GOOGLE_CLIENT_ID=""
ALLOWED_EMAIL_DOMAIN="desertica.pe"
# Mínimo 32 caracteres. Obligatorio en producción.
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-0123456789"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Segundos en que reusar un refresh token recién rotado (dos pestañas a la vez) no se toma por robo.
REFRESH_REUSE_GRACE_SECONDS=20
# Cookie del refresh token (`desertica_refresh`). `false` solo en desarrollo sin HTTPS; en producción siempre `Secure`.
REFRESH_COOKIE_SECURE=true
# SOLO desarrollo/pruebas: acepta ID tokens falsos "fake:<email>". Nunca en producción.
AUTH_ALLOW_FAKE_GOOGLE=false

# Cloudflare Turnstile (captcha de los endpoints públicos). Vacío = sin captcha; obligatorio en producción.
TURNSTILE_SECRET_KEY=""
# Destino de los avisos internos (contacto, reclamos, alertas de cobros). Obligatorio en producción.
STAFF_NOTIFY_EMAIL=""
# Minutos para pagar una reserva web antes de liberar el cupo, y cada cuántos segundos corre el barrido (0 = apagado).
PAYMENT_WINDOW_MINUTES=30
EXPIRY_SWEEP_SECONDS=60

# Correo saliente. `log` solo escribe en el log (desarrollo); producción exige `smtp`.
MAIL_DRIVER=log
# Con Google Workspace: smtp-relay.gmail.com (587, STARTTLS) autorizando la IP del servidor, o
# smtp.gmail.com con una contraseña de aplicación. Para probar en local: Mailpit en localhost:1025
# con SMTP_REQUIRE_TLS=false.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Desértica <reservas@desertica.pe>"
MAIL_REPLY_TO=""

# CMS (contenido editorial de los tours).
CMS_URL="http://localhost:1337"
CMS_API_TOKEN=""
CMS_CACHE_TTL_SECONDS=300

# Pagos. Claves de PRUEBA en desarrollo; las de producción solo en el entorno de despliegue.
# PAYMENT_GATEWAY_MODE=fake usa una pasarela simulada (solo desarrollo y pruebas).
PAYMENT_GATEWAY_MODE=live
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
CULQI_SECRET_KEY=""
CULQI_PUBLIC_KEY=""
CULQI_API_URL="https://api.culqi.com/v2"
CULQI_WEBHOOK_SECRET=""
REFUND_SWEEP_SECONDS=60

# Comprobantes (desertica-billing). BILLING_MODE=fake solo para desarrollo y pruebas.
BILLING_MODE=live
BILLING_URL="http://localhost:8080"
BILLING_SERVICE_TOKEN=""
# BILLING_SUBMISSION=IMMEDIATE
DOCUMENT_STORAGE_DIR="./storage/documents"
# Tipo de cambio USD→PEN de respaldo (SUNAT); lo normal es cargarlo en Setting `exchangeRateUsdPen`.
EXCHANGE_RATE_FALLBACK="3.7500"
PUBLIC_API_URL="http://localhost:3000/api"
DOCUMENT_WORKER_SECONDS=15
