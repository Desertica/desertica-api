# Copia este archivo a `.env` y ajusta los valores. Las variables se validan al
# arrancar (src/config/env.validation.ts): si falta una obligatoria, la API no inicia.

NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Credenciales locales de desarrollo (docker compose / Postgres nativo).
# No uses estos valores en producción.
DATABASE_URL="postgresql://desertica:desertica@localhost:5432/desertica?schema=public"

# Opcional. Sin Redis el rate limit y la caché viven en memoria (una sola instancia).
# REDIS_URL="redis://localhost:6379"

# Orígenes CORS permitidos, separados por coma (obligatorio en producción).
CORS_ORIGINS="http://localhost:4200,http://localhost:4300"
# Saltos de proxy confiables para leer la IP real (Cloudflare + Coolify: 2).
TRUST_PROXY=0
# Rate limit global por IP.
THROTTLE_LIMIT=120
THROTTLE_TTL_MS=60000

# Base de los enlaces que se mandan por correo (sitio público).
PUBLIC_WEB_URL="http://localhost:4200"

# Auth del staff (login con Google).
GOOGLE_CLIENT_ID=""
ALLOWED_EMAIL_DOMAIN="desertica.pe"
# Mínimo 32 caracteres. Obligatorio en producción.
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-0123456789"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# SOLO desarrollo/pruebas: acepta ID tokens falsos "fake:<email>". Nunca en producción.
AUTH_ALLOW_FAKE_GOOGLE=false

# CMS (contenido editorial de los tours).
CMS_URL="http://localhost:1337"
CMS_API_TOKEN=""
CMS_CACHE_TTL_SECONDS=300
